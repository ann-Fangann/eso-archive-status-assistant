# Optional. When enabled, the app asks MiniMax to help only with semantic
# column mapping or natural-language query planning. Business calculation
# still runs in deterministic Python code.
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7-highspeed
ENABLE_LLM_MAPPING=false
ENABLE_LLM_QUERY=false
